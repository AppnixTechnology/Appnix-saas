generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  status        TenantStatus   @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  crmContacts   CrmContact[]
  subscriptions Subscription[]
  users         User[]
  campaigns     Campaign[]
  campaignAudiences CampaignAudience[]
  channelConfigs ChannelConfig[]
  metaTemplates MetaTemplate[]
  appCredentials AppCredential[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid())
  email              String    @unique
  passwordHash       String?
  name               String?
  avatar             String?
  googleId           String?   @unique
  role               Role      @default(MEMBER)
  tenantId           String
  hashedRefreshToken String?
  passwordResetToken String?
  passwordResetExpiry DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("users")
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodStart   DateTime           @default(now())
  currentPeriodEnd     DateTime
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("subscriptions")
}

model CrmContact {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("crm_contacts")
}

model Campaign {
  id                  String              @id @default(uuid())
  tenantId            String
  name                String
  description         String?
  audienceId          String?
  audienceName        String?
  audienceCount       Int                 @default(0)
  audienceSnapshot    Json?
  channel             ChannelType
  metaTemplateId      String?
  metaTemplateName    String?
  metaTemplateLanguage String?
  templateVariables   Json?
  variableMappings    Json?
  status              CampaignStatus      @default(DRAFT)
  launchMode          LaunchMode          @default(IMMEDIATE)
  scheduledAt         DateTime?
  testSentAt          DateTime?
  testRecipient       String?
  testStatus          TestStatus?
  testMessageId       String?
  launchedAt          DateTime?
  completedAt         DateTime?
  errorMessage        String?
  createdBy           String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([status])
  @@map("campaigns")
}

model CampaignAudience {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  contactIds  String[]
  contactCount Int     @default(0)
  status      AudienceStatus @default(ACTIVE)
  lastUpdated DateTime @default(now()) @updatedAt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("campaign_audiences")
}

model ChannelConfig {
  id           String        @id @default(uuid())
  tenantId     String
  channel      ChannelType
  isConnected  Boolean       @default(false)
  config       Json?
  connectedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, channel])
  @@index([tenantId])
  @@map("channel_configs")
}

model MetaTemplate {
  id            String           @id @default(uuid())
  tenantId      String
  metaTemplateId String          @unique
  name          String
  category      TemplateCategory
  language      String
  status        TemplateStatus
  components    Json
  preview       String?
  lastSyncedAt  DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("meta_templates")
}

model Folder {
  id          String     @id @default(uuid())
  tenantId    String?
  name        String
  workflows   Workflow[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("folders")
}

model Workflow {
  id          String         @id @default(uuid())
  tenantId    String?
  title       String
  status      Boolean        @default(true)
  folderId    String?
  folder      Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  triggerType TriggerType    @default(INBOUND_MESSAGE)
  tags        String[]       @default([])
  nodes       Json           @default("[]")
  edges       Json           @default("[]")
  isLocked    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([folderId])
  @@map("workflows")
}

model WorkflowLicense {
  id          String    @id @default(uuid())
  key         String    @unique
  workflowId  String?
  workflowTitle String?
  redeemedBy  String?
  isRedeemed  Boolean   @default(false)
  redeemedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("workflow_licenses")
}

model DataStore {
  id          String            @id @default(uuid())
  tenantId    String?
  name        String
  slug        String            @unique
  description String?
  keyType     String            @default("STRING")
  ttlSeconds  Int?              // Optional time-to-live for transient data
  recordLimit Int               @default(10000)
  records     DataStoreRecord[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("data_stores")
}

model DataStoreRecord {
  id          String    @id @default(uuid())
  dataStoreId String
  dataStore   DataStore @relation(fields: [dataStoreId], references: [id], onDelete: Cascade)
  key         String    // Unique lookup key per store (e.g. phone or userId)
  value       Json      // Structured JSON record payload
  expiresAt   DateTime? // Computed from TTL
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([dataStoreId, key])
  @@index([dataStoreId, key])
  @@index([expiresAt])
  @@map("data_store_records")
}

model WorkflowTemplate {
  id           String   @id @default(uuid())
  title        String
  slug         String   @unique
  description  String
  category     String   // E_COMMERCE, SUPPORT, MARKETING, LEAD_GEN, UTILITY
  channels     String[] // WHATSAPP, RCS, FACEBOOK, INSTAGRAM
  apps         String[] // SHOPIFY, WEBHOOK, GOOGLE_SHEETS, AI_AGENT
  nodes        Json     @default("[]")
  edges        Json     @default("[]")
  isPremium    Boolean  @default(false)
  installCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("workflow_templates")
}

model AppCredential {
  id                   String    @id @default(uuid())
  tenantId             String?
  appName              String    // SHOPIFY, OPENAI, RAZORPAY, CUSTOM_WEBHOOK, STRIPE, HUBSPOT, etc.
  accountName          String    // User label: e.g., "Production Shopify"
  authType             AuthType
  credentials          Json      // Encrypted credentials payload (API keys, secret tokens)
  isActive             Boolean   @default(true)
  lastTestedAt         DateTime?
  isHealthy            Boolean   @default(true)
  linkedWorkflowsCount Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("app_credentials")
}

enum AuthType {
  API_KEY
  BEARER_TOKEN
  OAUTH2
  BASIC_AUTH
}

enum TriggerType {
  INBOUND_MESSAGE
  WEBHOOK_EVENT
  SCHEDULED_CRON
  FORM_SUBMISSION
}

enum CampaignStatus {
  DRAFT
  READY_FOR_TEST
  TEST_SENT
  SCHEDULED
  LAUNCHING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LaunchMode {
  IMMEDIATE
  SCHEDULED
}

enum TestStatus {
  PENDING
  SENT
  FAILED
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  RCS
  FACEBOOK
}

enum AudienceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum TemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
}

enum TemplateStatus {
  APPROVED
  PENDING
  REJECTED
  PAUSED
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  MEMBER
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}
