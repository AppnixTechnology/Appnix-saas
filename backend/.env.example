PORT=4000
NODE_ENV=development

# PostgreSQL + Prisma ORM Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/appnix_saas?schema=public"

# Auth / JWT Configuration
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"
JWT_ACCESS_SECRET="super-secret-jwt-access-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production"
JWT_REFRESH_EXPIRY="7d"

# Frontend Application URL
FRONTEND_URL="http://localhost:3000"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:4000/api/v1/auth/google/callback"

# Stripe / Billing
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Brevo Transactional Email Service
BREVO_API_KEY="xkeysib-your-brevo-api-key"
BREVO_SENDER_NAME="Appnix"
BREVO_SENDER_EMAIL="admin@appnix.info"
